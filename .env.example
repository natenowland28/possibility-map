# ── AI (optional — without a key the app runs in Demo mode with sample reflections)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5        # default
# AI_EFFORT=medium                # low | medium | high — depth of reflection vs. speed/cost
# AI_MODE=demo                    # force demo mode even when a key is set

# ── Facilitator dashboard (/admin)
ADMIN_PASSWORD=change-me

# ── Email the facilitator each submission (optional, via resend.com)
# RESEND_API_KEY=
# FACILITATOR_EMAIL=you@example.com
# RESEND_FROM="Possibility Map <hello@yourdomain.com>"

# ── Storage when hosted (optional). Locally, sessions are saved to ./data/sessions
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Server speech-to-text fallback for browsers without built-in voice, e.g. Firefox (optional)
# OPENAI_API_KEY=
